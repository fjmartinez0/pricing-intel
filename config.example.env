# Copy to config.env (never committed) and fill in.
NTFY_SERVER=https://ntfy.sh
# Long random topic names: anyone who knows a topic name can read it.
NTFY_TOPIC=pricing-CHANGE-ME-new-roles
NTFY_FAIL_TOPIC=pricing-CHANGE-ME-problems
# Your GitHub Pages address, opened when you tap an alert.
DASHBOARD_URL=https://YOUR-USERNAME.github.io/pricing-intel/
# Claude Code settings for the discovery step.
CLAUDE_MODEL=opus
CLAUDE_MAX_TURNS=250
